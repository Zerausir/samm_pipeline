FROM apache/airflow:slim-3.2.0-python3.14

USER root

# Dependencias del sistema para geopandas y librerías geoespaciales
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libgdal-dev \
        libspatialindex-dev \
        unixodbc-dev \
        unixodbc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Dependencias Python — numpy pinneado explícitamente por seguridad
RUN pip install --no-cache-dir \
    "numpy==2.4.4" \
    "asyncpg==0.31.0" \
    "psycopg2-binary==2.9.11" \
    "geopandas==1.1.3" \
    "pyodbc==5.3.0" \
    "environs==15.0.1" \
    "openpyxl==3.1.5" \
    "pykml==0.2.0" \
    "sqlalchemy==2.0.49" \
    "pyarrow==23.0.1"

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/entrypoint"]