FROM apache/airflow:slim-3.2.0-python3.14

USER root

# Dependencias del sistema para geopandas y librerías geoespaciales
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libgdal-dev \
        libspatialindex-dev \
        unixodbc-dev \
        unixodbc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Dependencias Python — numpy pinneado explícitamente por seguridad
RUN pip install --no-cache-dir \
    "numpy==2.4.4" \
    "marshmallow>=3.13.0,<4.0.0" \
    psycopg2-binary \
    geopandas \
    pyodbc \
    environs \
    openpyxl \
    pykml \
    shapely \
    pandas \
    sqlalchemy \
    fiona \
    pyproj \
    pyarrow

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/entrypoint"]