FROM apache/airflow:slim-3.3.0-python3.14
# Subido de 3.2.0 a 3.3.0 (23-jul-2026). Mismo cambio aplicado el mismo dia
# en sietel_pipeline: la UI se colgaba con sqlalchemy.exc.TimeoutError:
# QueuePool limit reached durante una carga historica larga con el Grid
# abierto -- el pool ampliado (20+30) tambien se agoto, indicando una fuga
# de conexiones, consistente con bugs de sesion/auth documentados en el
# changelog oficial de Airflow (3.2.1: "Fix FAB auth_manager load_user
# causing PendingRollbackError"; discusion oficial de Airflow confirma un
# bug identico arreglado en 3.1.5). No hay una entrada de changelog que
# mencione el bug exacto por su nombre -- monitorear tras el cambio.
#
# Se mantiene la version alineada con sietel_pipeline (mismo Dockerfile.airflow
# base) para no reintroducir el problema de mantenimiento que motivo la
# alineacion original.

USER root

# Dependencias del sistema para geopandas y librerías geoespaciales
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libgdal-dev \
        libspatialindex-dev \
        unixodbc-dev \
        unixodbc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Dependencias Python — numpy pinneado explícitamente por seguridad
RUN pip install --no-cache-dir \
    "numpy==2.4.4" \
    "asyncpg==0.31.0" \
    "psycopg2-binary==2.9.11" \
    "geopandas==1.1.3" \
    "pyodbc==5.3.0" \
    "environs==15.0.1" \
    "openpyxl==3.1.5" \
    "pykml==0.2.0" \
    "sqlalchemy==2.0.49" \
    "pyarrow==23.0.1"

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/entrypoint"]